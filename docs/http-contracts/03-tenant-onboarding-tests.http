Accept: application/json
Accept-Language: en

{
  "logoUrl": "https://example.com/logo.png",
  "themeColors": {"primary": "#000000"},
  "socialLinks": {},
  "welcomeMessage": "Test"
}

### =====================================================================
### 3.6 SECURITY TESTS - SQL INJECTION & XSS
### =====================================================================

### 3.6.1 SQL Injection in Company Name - Expect 200 OK (safely stored as literal text, no injection)
# @name registerSqlInjection
POST {{HostAddress}}/api/v1/tenants/register
Content-Type: application/json
Accept: application/json
Accept-Language: ar

{
  "companyNameAr": "شركة اختبار",
  "companyNameEn": "Company'; DROP TABLE tenants; --",
  "subdomain": "sqlin",
  "commercialRegistrationNumber": "1001234570",
  "nationalUnifiedNumber700": "7001234570",
  "adminFullName": "Test",
  "adminEmail": "sql@test.com",
  "adminPhoneNumber": "+966500000006",
  "password": "SecurePassword@123",
  "activationMethod": 1
}

### 3.6.2 XSS Payload in Company Name - Expect 200 OK (stored as literal text, escaped on render)
# @name registerXss
POST {{HostAddress}}/api/v1/tenants/register
Content-Type: application/json
Accept: application/json
Accept-Language: en

{
  "companyNameAr": "شركة اختبار XSS",
  "companyNameEn": "<script>alert('xss')</script>",
  "subdomain": "xsstest",
  "commercialRegistrationNumber": "1001234571",
  "nationalUnifiedNumber700": "7001234571",
  "adminFullName": "Test",
  "adminEmail": "xss@test.com",
  "adminPhoneNumber": "+966500000007",
  "password": "SecurePassword@123",
  "activationMethod": 1
}
