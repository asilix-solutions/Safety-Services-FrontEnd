@baseUrl = http://localhost:5128
@HostAddress = {{baseUrl}}
@newSubdomain = safetyleaders
@adminEmail = manager@safetyleaders.com

### =====================================================================
### 03. TENANT ONBOARDING & ENTERPRISE REGISTRATION TEST SUITE
### =====================================================================
### Comprehensive tenant registration, OTP verification, and settings configuration.
### Token extraction: VerifyOtpResponse uses 'Token' field (not 'token')
### DevOnlyOtp is only populated when FeatureToggles:IsOtpReturnInsideTheResponse=true
### (Development only) — chain it directly instead of hardcoding "123456".
### Registration now captures CompanyNameAr/CompanyNameEn and separate
### CommercialRegistrationNumber/NationalUnifiedNumber700 fields (both 10 digits).

### =====================================================================
### 3.1 SUBDOMAIN AVAILABILITY VALIDATION
### =====================================================================
### Response is now a SubdomainCheckResultDto: { isAvailable, normalizedSlug, message }

### 3.1.1 Check Subdomain Availability - Available - Expect 200 OK with isAvailable = true
# @name checkSubdomainAvailable
GET {{HostAddress}}/api/v1/tenants/subdomains/{{newSubdomain}}/availability
Accept: application/json
Accept-Language: en

### 3.1.2 Check Subdomain Availability - Already Taken (al-salamah) - Expect 200 OK with isAvailable = false
# @name checkSubdomainTaken
GET {{HostAddress}}/api/v1/tenants/subdomains/al-salamah/availability
Accept: application/json
Accept-Language: ar

### 3.1.3 Check Subdomain Availability - Reserved Keyword (FR-TNT-02) - Expect 200 OK with isAvailable = false
# @name checkSubdomainReserved
GET {{HostAddress}}/api/v1/tenants/subdomains/api/availability
Accept: application/json
Accept-Language: en

### 3.1.4 Check Subdomain Availability - Reserved Keyword (admin) - Expect 200 OK with isAvailable = false
# @name checkSubdomainReservedAdmin
GET {{HostAddress}}/api/v1/tenants/subdomains/admin/availability
Accept: application/json
Accept-Language: ar

### 3.1.5 Check Subdomain Availability - Invalid Format (uppercase) - Expect 200 OK with isAvailable = false
# @name checkSubdomainInvalidFormat
GET {{HostAddress}}/api/v1/tenants/subdomains/INVALID_Format/availability
Accept: application/json
Accept-Language: en

### =====================================================================
### 3.2 TENANT REGISTRATION - HAPPY PATH (ManualPlatformApproval pathway)
### =====================================================================

### 3.2.1 Register New Enterprise (ActivationMethod=1 ManualPlatformApproval) - Expect 200 OK
# @name registerTenant
POST {{HostAddress}}/api/v1/tenants/register
Content-Type: application/json
Accept: application/json
Accept-Language: ar

{
  "companyNameAr": "شركة البدر لأنظمة السلامة",
  "companyNameEn": "Al-Badr Safety Systems Co.",
  "subdomain": "{{newSubdomain}}",
  "commercialRegistrationNumber": "1009876543",
  "nationalUnifiedNumber700": "7009876543",
  "adminFullName": "Eng. Tariq Al-Mansoor",
  "adminEmail": "{{adminEmail}}",
  "adminPhoneNumber": "+966555123456",
  "password": "SecureAdmin@123456",
  "activationMethod": 1
}

@registeredTenantId = {{registerTenant.response.body.data.tenantId}}
@registeredAdminUserId = {{registerTenant.response.body.data.adminUserId}}
@registeredOtp = {{registerTenant.response.body.data.devOnlyOtp}}

### =====================================================================
### 3.3 OTP VERIFICATION & TENANT ACTIVATION
### =====================================================================

### 3.3.1 Verify Security OTP & Activate Admin Identity - Expect 200 OK with JWT Token
### Response.ActivationStatus should be "PendingManualApproval" (2) since ActivationMethod=1
# @name verifyOtp
POST {{HostAddress}}/api/v1/tenants/verify-otp
Content-Type: application/json
Accept: application/json
Accept-Language: ar

{
  "userId": "{{registeredAdminUserId}}",
  "otpCode": "{{registeredOtp}}"
}

@authToken = {{verifyOtp.response.body.data.Token}}

### =====================================================================
### 3.4 POST-ACTIVATION: TENANT SETTINGS CONFIGURATION
### =====================================================================

### 3.4.1 Update Tenant Visual Branding & Theme - Expect 200 OK
# @name updateBranding
PUT {{HostAddress}}/api/v1/tenants/settings/branding
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json
Accept-Language: ar

{
  "logoUrl": "https://cdn.safetyleaders.com/logo.png",
  "faviconUrl": "https://cdn.safetyleaders.com/favicon.ico",
  "themeColors": {
    "primary": "#0055ff",
    "secondary": "#ff9900",
    "accent": "#10b981"
  },
  "socialLinks": {
    "twitter": "https://twitter.com/safetyleaders",
    "linkedin": "https://linkedin.com/company/safetyleaders"
  },
  "welcomeMessage": "Welcome to Al-Badr Safety Systems"
}

### 3.4.2 Update SEO Metadata & OpenGraph - Expect 200 OK
# @name updateSeoOg
PUT {{HostAddress}}/api/v1/tenants/settings/seo-og
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json
Accept-Language: en

{
  "seoTitle": "Al-Badr Safety Systems | Fire Safety KSA",
  "seoDescription": "Leading safety contracting enterprise.",
  "seoKeywords": "fire safety, civil defense, contractors",
  "ogTitle": "Al-Badr Safety Systems",
  "ogDescription": "Engineering Protection Solutions",
  "ogImage": "https://cdn.safetyleaders.com/og-banner.jpg",
  "ogType": "website",
  "twitterCard": "summary_large_image",
  "twitterSite": "@safetyleaders",
  "canonicalUrl": "https://safetyleaders.amanix.com"
}

### 3.4.3 Update Public Contact Info - Expect 200 OK
# @name updateContact
PUT {{HostAddress}}/api/v1/tenants/settings/contact
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json
Accept-Language: ar

{
  "publicEmail": "info@safetyleaders.com",
  "publicPhone": "+966114567890",
  "address": "Riyadh, Saudi Arabia",
  "aboutUsText": "Al-Badr Safety Systems specializes in fire alarm and suppression systems."
}

### 3.4.4 Fetch Tenant Settings Verification - Expect 200 OK
# @name getSettings
GET {{HostAddress}}/api/v1/tenants/settings
Authorization: Bearer {{authToken}}
Accept: application/json
Accept-Language: en

