### =====================================================================
### 5.4 USER STATUS MANAGEMENT
### =====================================================================

### 5.4.1 Toggle User Status (Activate/Deactivate) - Expect 200 OK
# @name toggleUserStatus
PATCH {{HostAddress}}/api/v1/tenant-users/{{newUserId}}/toggle-status
Authorization: Bearer {{companyAdminToken}}
Accept: application/json
Accept-Language: ar

### =====================================================================
### 5.5 PERMISSIONS MANAGEMENT & RBAC
### =====================================================================

### 5.5.1 Retrieve System Permissions Catalog (Assignable Roles) - Expect 200 OK
# @name getCatalog
GET {{HostAddress}}/api/v1/tenant-users/permissions-catalog
Authorization: Bearer {{companyAdminToken}}
Accept: application/json
Accept-Language: en

### 5.5.2 Get Specific User Inherited & Direct Permissions - Expect 200 OK
# @name getUserPermissions
GET {{HostAddress}}/api/v1/tenant-users/{{newUserId}}/permissions
Authorization: Bearer {{companyAdminToken}}
Accept: application/json
Accept-Language: ar

### 5.5.3 Update Direct User Permission Overrides - Expect 200 OK
# @name updateUserPermissions
PUT {{HostAddress}}/api/v1/tenant-users/{{newUserId}}/permissions
Authorization: Bearer {{companyAdminToken}}
Content-Type: application/json
Accept: application/json
Accept-Language: en

[
  "{{getCatalog.response.body.data.permissionCategories[0].permissions[0].id}}"
]

### =====================================================================
### 5.6 DEPUTY ADMIN PERMISSION BOUNDARY (Operational clearance, NOT sovereign management)
### =====================================================================

### 5.6.1 DeputyAdmin CANNOT list/manage tenant users - Expect 403 Forbidden
# @name deputyAdminBlockedFromUserList
GET {{HostAddress}}/api/v1/tenant-users?pageNumber=1&pageSize=10
Authorization: Bearer {{deputyAdminToken}}
Accept: application/json
Accept-Language: en

### 5.6.2 DeputyAdmin CANNOT create tenant users - Expect 403 Forbidden
# @name deputyAdminBlockedFromCreateUser
POST {{HostAddress}}/api/v1/tenant-users
Authorization: Bearer {{deputyAdminToken}}
Content-Type: application/json
Accept: application/json
Accept-Language: ar

{
  "fullName": "Blocked Attempt",
  "email": "blocked.attempt@al-salamah.com",
  "password": "User@123456",
  "phoneNumber": "+966501122338",
  "role": 202,
  "preferredLanguage": "ar"
}

### 5.6.3 DeputyAdmin CAN view audit logs (operational transparency retained) - Expect 200 OK
# @name deputyAdminAllowedAuditLogs
GET {{HostAddress}}/api/v1/audit-logs?pageNumber=1&pageSize=10
Authorization: Bearer {{deputyAdminToken}}
Accept: application/json
Accept-Language: en

### 5.6.4 DeputyAdmin CAN view pending resource approvals (operational clearance) - Expect 200 OK
# @name deputyAdminAllowedResourceApprovals
GET {{HostAddress}}/api/v1/resource-approvals
Authorization: Bearer {{deputyAdminToken}}
Accept: application/json
Accept-Language: ar

