@baseUrl = http://localhost:5128
@HostAddress = {{baseUrl}}
@companyAdminEmail = admin@al-salamah.com
@companyAdminPassword = User@123456
@deputyAdminEmail = deputy@al-salamah.com
@deputyAdminPassword = User@123456

### =====================================================================
### 05. TENANT USER MANAGEMENT & RBAC TEST SUITE (COMPLETE)
### =====================================================================
### Token extraction fix: Login returns 'Token' field
### Role numeric ids: CompanyAdmin=200, DeputyAdmin=201, ConsultingEngineer=202,
### OperationsOfficer=203, FieldWorker=204, MaintenanceManager=205,
### SalesRepresentative=206, Client=207, MaintenanceWorker=208

### =====================================================================
### 5.1 AUTHENTICATION & SETUP
### =====================================================================

### 5.1.1 Login as Company Admin (English) - Expect 200 OK
# @name companyAdminLogin
POST {{HostAddress}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json
Accept-Language: en
X-Tenant-Domain: al-salamah

{
  "email": "{{companyAdminEmail}}",
  "password": "{{companyAdminPassword}}"
}

@companyAdminToken = {{companyAdminLogin.response.body.data.Token}}

### 5.1.2 Login as Company Admin (Arabic) - Expect 200 OK
# @name companyAdminLoginAr
POST {{HostAddress}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json
Accept-Language: ar
X-Tenant-Domain: al-salamah

{
  "email": "{{companyAdminEmail}}",
  "password": "{{companyAdminPassword}}"
}

### 5.1.3 Login as Deputy Admin (For Permission Boundary Tests) - Expect 200 OK
# @name deputyAdminLogin
POST {{HostAddress}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json
Accept-Language: en
X-Tenant-Domain: al-salamah

{
  "email": "{{deputyAdminEmail}}",
  "password": "{{deputyAdminPassword}}"
}

@deputyAdminToken = {{deputyAdminLogin.response.body.data.Token}}

### =====================================================================
### 5.2 LIST STAFF USERS WITHIN TENANT BOUNDARY
### =====================================================================

### 5.2.1 Get Users (Default Pagination) - Expect 200 OK
# @name getUsers
GET {{HostAddress}}/api/v1/tenant-users?pageNumber=1&pageSize=10
Authorization: Bearer {{companyAdminToken}}
Accept: application/json
Accept-Language: ar

### 5.2.2 Get Users (Page 2) - Expect 200 OK
# @name getUsersPage2
GET {{HostAddress}}/api/v1/tenant-users?pageNumber=2&pageSize=10
Authorization: Bearer {{companyAdminToken}}
Accept: application/json
Accept-Language: en

### 5.2.3 Get Users with Search Term - Expect 200 OK
# @name getUsersWithSearch
GET {{HostAddress}}/api/v1/tenant-users?pageNumber=1&pageSize=10&searchTerm=engineer
Authorization: Bearer {{companyAdminToken}}
Accept: application/json
Accept-Language: ar

### 5.2.4 Get Users with Role Filter (ConsultingEngineer = 202) - Expect 200 OK
# @name getUsersWithRoleFilter
GET {{HostAddress}}/api/v1/tenant-users?pageNumber=1&pageSize=10&role=202
Authorization: Bearer {{companyAdminToken}}
Accept: application/json
Accept-Language: en

### 5.2.5 Get Users with Active Filter - Expect 200 OK
# @name getUsersActiveOnly
GET {{HostAddress}}/api/v1/tenant-users?pageNumber=1&pageSize=10&isActive=true
Authorization: Bearer {{companyAdminToken}}
Accept: application/json
Accept-Language: ar

