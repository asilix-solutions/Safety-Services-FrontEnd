  "fullName": "Eng. Faisal Al-Harbi",
  "email": "faisal.engineer@al-salamah.com",
  "password": "User@123456",
  "phoneNumber": "+966559988776",
  "role": 202,
  "preferredLanguage": "ar"
}

@newUserId = {{createUser.response.body.data}}

