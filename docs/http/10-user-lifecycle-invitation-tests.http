@baseUrl = http://localhost:5128
@HostAddress = {{baseUrl}}
@superAdminEmail = admin@amanix.com
@superAdminPassword = Admin@123456
@companyAdminEmail = admin@al-salamah.com
@companyAdminPassword = User@123456
@deputyAdminEmail = deputy@al-salamah.com
@deputyAdminPassword = User@123456

### =====================================================================
### 10. USER LIFECYCLE, INVITATION GATEWAYS & CLIENT SELF-REGISTRATION
### =====================================================================
### Covers all 3 provisioning pathways added in this pass:
### - Platform HQ staff invitation (SystemSuperAdmin -> PlatformSupport/PlatformFinance)
### - Tenant staff invitation (CompanyAdmin -> DeputyAdmin/ConsultingEngineer/.../MaintenanceWorker)
### - Client self-registration on a branded subdomain (OTP-verified)
### DevOnlyInvitationToken/DevOnlyAcceptanceUrl and DevOnlyOtp are only populated when
### FeatureToggles:IsInvitationTokenReturnInsideTheResponse / IsOtpReturnInsideTheResponse
### are true (Development only) — both default true in appsettings.Development.json.

### =====================================================================
### 10.1 AUTHENTICATION & SETUP
### =====================================================================

### 10.1.1 Login as Platform SystemSuperAdmin - Expect 200 OK
# @name superAdminLogin
POST {{HostAddress}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json
Accept-Language: en

{
  "email": "{{superAdminEmail}}",
  "password": "{{superAdminPassword}}"
}

@superAdminToken = {{superAdminLogin.data.token}}

### 10.1.2 Login as Company Admin - Expect 200 OK
# @name companyAdminLogin
POST {{HostAddress}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json
Accept-Language: en
X-Tenant-Domain: al-salamah

{
  "email": "{{companyAdminEmail}}",
  "password": "{{companyAdminPassword}}"
}

@companyAdminToken = {{companyAdminLogin.data.token}}

### 10.1.3 Login as Deputy Admin (for negative/boundary tests) - Expect 200 OK
# @name deputyAdminLogin
POST {{HostAddress}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json
Accept-Language: en
X-Tenant-Domain: al-salamah

{
  "email": "{{deputyAdminEmail}}",
  "password": "{{deputyAdminPassword}}"
}

@deputyAdminToken = {{deputyAdminLogin.data.token}}

### =====================================================================
### 10.2 FLOW 1 — PLATFORM HQ: SuperAdmin invites PlatformSupport -> accepts -> logs in
### =====================================================================

### 10.2.1 SuperAdmin Invites a PlatformSupport Staff Member - Expect 201 Created
# @name invitePlatformSupport
POST {{HostAddress}}/api/v1/platform/staff
Authorization: Bearer {{superAdminToken}}
Content-Type: application/json
Accept: application/json
Accept-Language: ar

{
  "fullName": "Yousef Al-Amri",
  "email": "yousef.support@amanix.com",
  "phoneNumber": "+966501234561",
  "role": 101,
  "preferredLanguage": "ar"
}

@platformSupportUserId = {{invitePlatformSupport.data.userId}}
@platformSupportInvitationToken = {{invitePlatformSupport.data.devOnlyInvitationToken}}

### 10.2.2 Invited PlatformSupport Accepts the Invitation - Expect 200 OK with JWT
# @name acceptPlatformInvitation
POST {{HostAddress}}/api/v1/auth/accept-platform-invitation
Content-Type: application/json
Accept: application/json
Accept-Language: en

{
  "userId": "{{platformSupportUserId}}",
  "invitationToken": "{{platformSupportInvitationToken}}",
  "newPassword": "SupportSecure@123",
  "confirmPassword": "SupportSecure@123"
}

@platformSupportToken = {{acceptPlatformInvitation.data.accessToken}}

### 10.2.3 New PlatformSupport Logs In With Their Chosen Password - Expect 200 OK
# @name platformSupportLogin
POST {{HostAddress}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json
Accept-Language: en

{
  "email": "yousef.support@amanix.com",
  "password": "SupportSecure@123"
}

### 10.2.4 SuperAdmin Invites a PlatformFinance Staff Member - Expect 201 Created
# @name invitePlatformFinance
POST {{HostAddress}}/api/v1/platform/staff
Authorization: Bearer {{superAdminToken}}
Content-Type: application/json
Accept: application/json
Accept-Language: en

{
  "fullName": "Nourah Al-Fahad",
  "email": "nourah.finance@amanix.com",
  "phoneNumber": "+966501234562",
  "role": 102,
  "preferredLanguage": "ar"
}

@platformFinanceUserId = {{invitePlatformFinance.data.userId}}
@platformFinanceInvitationToken = {{invitePlatformFinance.data.devOnlyInvitationToken}}

### 10.2.5 Invited PlatformFinance Accepts the Invitation - Expect 200 OK with JWT
# @name acceptPlatformFinanceInvitation
POST {{HostAddress}}/api/v1/auth/accept-platform-invitation
Content-Type: application/json
Accept: application/json
Accept-Language: ar

{
  "userId": "{{platformFinanceUserId}}",
  "invitationToken": "{{platformFinanceInvitationToken}}",
  "newPassword": "FinanceSecure@123",
  "confirmPassword": "FinanceSecure@123"
}

