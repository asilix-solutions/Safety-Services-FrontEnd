@baseUrl = http://localhost:5128
@HostAddress = {{baseUrl}}
@superAdminEmail = admin@amanix.com
@superAdminPassword = Admin@123456
@superAdminEmailWrong = admin.wrong@amanix.com
@tenantManagerEmail = admin@al-salamah.com
@tenantManagerPassword = User@123456
@tenantManagerEmailWrong = admin.wrong@al-salamah.com
@newPassword = NewSecurePassword@123456

### =====================================================================
### 02. AUTHENTICATION & IAM SECURITY TEST SUITE (COMPLETE COVERAGE)
### =====================================================================
### This suite tests all authentication flows, token management, and security scenarios.
### Token extraction fix: LoginResponse uses 'Token' field (not 'accessToken')
### RefreshTokenResponse serialises as 'accessToken' and 'refreshToken' (camelCase, like every response)

### =====================================================================
### 2.1 HAPPY PATH - SUCCESSFUL AUTHENTICATION SCENARIOS
### =====================================================================

### 2.1.1 Platform SuperAdmin Login (Arabic Language Header) - Expect 200 OK
# @name superAdminLoginAr
POST {{HostAddress}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json
Accept-Language: ar

{
  "email": "{{superAdminEmail}}",
  "password": "{{superAdminPassword}}"
}

### 2.1.2 Platform SuperAdmin Login (English Language Header) - Expect 200 OK
# @name superAdminLoginEn
POST {{HostAddress}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json
Accept-Language: en

{
  "email": "{{superAdminEmail}}",
  "password": "{{superAdminPassword}}"
}

@superAdminToken = {{superAdminLoginEn.data.token}}

### 2.1.3 Tenant Manager Login (with Subdomain Header) - Expect 200 OK
# @name tenantManagerLogin
POST {{HostAddress}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json
Accept-Language: ar
X-Tenant-Domain: al-salamah

{
  "email": "{{tenantManagerEmail}}",
  "password": "{{tenantManagerPassword}}"
}

@tenantManagerToken = {{tenantManagerLogin.data.token}}

### 2.1.4 Tenant Manager Login (English) - Expect 200 OK
# @name tenantManagerLoginEn
POST {{HostAddress}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json
Accept-Language: en
X-Tenant-Domain: al-salamah

{
  "email": "{{tenantManagerEmail}}",
  "password": "{{tenantManagerPassword}}"
}

